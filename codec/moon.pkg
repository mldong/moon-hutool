// 骨架期：实现体全是 abort，所以不 import 任何非测试依赖（未使用的 import 会吃 unused_package 警告并卡零警告门禁）。
// 测试侧要用 core 的标准 Base64 做对拍腿（G8）、用 utf8 造字节夹具；Base58Check 的校验位由实现内部走 digest，PR-B 时再挂非测试依赖。
import {
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "mldong/moon-hutool/codec",
} for "test"

// 骨架期豁免（各错误变体没人构造、签名有 raise 而体里没 raise）。
// 实现落地那一笔必须删掉——门禁 G12 拦着不让忘。

warnings = "-unused_constructor-unused_error_type"
