// 契约骨架期：体全是 abort ⇒ 错误变体没人构造、raise 没人抛，那两类警告是"未实现"的机械后果，
// 按 G12 压掉（键只能出现一次、flag 连写不带空格/逗号）；落地笔整行删除。
warnings = "-unused_value-struct_never_constructed-unused_constructor-unused_error_type-unused_trait_bound"

// 时刻与日期算术全部委托 date 包（本包不重算月末/闰年/epoch，spec §1 末行）
import {
  "mldong/moon-hutool/date",
}

import {
  "mldong/moon-hutool/cron",
  "mldong/moon-hutool/date",
} for "test"
