// `lcm`/`factorial`/`combination_count`/`arrangement_count` 的签名就带 `BigInt`
// （增长型算术只在精确域出，理由见 spec §0.1 与 #8.6），所以本包**非测试**侧要 import core 的
// bigint——零依赖契约只允许 `moonbitlang/core`，这一条在内。
import {
  "moonbitlang/core/bigint",
  "moonbitlang/core/int",
  "moonbitlang/core/string",
}

// 测试侧：BigInt 造夹具与判等、`@double` 的 NaN/±Infinity 喂报错面（对拍腿走 core 现成件，见 G8）
import {
  "moonbitlang/core/bigint",
  "moonbitlang/core/double",
  "mldong/moon-hutool/num",
} for "test"

// 第二批（薄 Money + 格式化三件）此刻是骨架 ⇒ 豁免重新挂上，三条都是"未实现"的机械后果：
// - `unused_constructor`：`Money` 的构造与五个新错误变体还没人用
// - `unused_error_type`：新签名写了 `raise NumError` 而体里没有 `raise`
// - `struct_never_constructed`：`Money` 还没被构造出来过
// 第二批实现落地那一笔必须整行删掉——G12 上一轮真拦到过它，这不是空转门禁。

warnings = "-unused_constructor-unused_error_type-struct_never_constructed"
