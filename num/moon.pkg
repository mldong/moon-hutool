// `lcm`/`factorial`/`combination_count`/`arrangement_count` 的签名就带 `BigInt`
// （增长型算术只在精确域出，理由见 spec §0.1 与 #8.6），所以本包**非测试**侧要 import core 的
// bigint——零依赖契约只允许 `moonbitlang/core`，这一条在内。
import {
  "moonbitlang/core/bigint",
  "moonbitlang/core/int",
  "moonbitlang/core/int64",
  "moonbitlang/core/string",
}

// 测试侧：BigInt 造夹具与判等、`@double` 的 NaN/±Infinity 喂报错面（对拍腿走 core 现成件，见 G8）
import {
  "moonbitlang/core/bigint",
  "moonbitlang/core/double",
  "mldong/moon-hutool/num",
} for "test"

// 第二批实现已落地 ⇒ 骨架期那三条豁免整行删除（G12 盯着这一条：体里没有 abort 就不许再压豁免）。

// 第三批骨架期豁免（体里全是 abort 的机械后果，实现落地那一笔整行删除——G12 盯着）：
// unused_value（形参没人用）、unused_error_type（新三条 raise 档没人抛）、unused_constructor（新档位没人构造）

warnings = "-unused_value-unused_error_type-unused_constructor"
