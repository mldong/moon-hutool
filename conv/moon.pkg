// 实现落地的这一笔起，骨架豁免整行删除（G12 盯着这一条：体里没有 abort 就不许再压豁免）。
//
// 非测试侧的依赖全是 `moonbitlang/core` + 本仓自己的 `text`——零依赖契约（只用 core、零 extern、
// 全同步）没破：`@text.trim`/`is_blank`/`split` 是上一包的公开面，跨包 import 在本仓有先例
// （`codec`→`digest`、`id`→`digest`）。签名里带 `BigInt`/`Int64` 也要对应包在案。
import {
  "mldong/moon-hutool/text",
  "moonbitlang/core/bigint",
  "moonbitlang/core/double",
  "moonbitlang/core/int",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

// 测试侧：@json.parse 造夹具、@double 的 ±Infinity 喂越界档、@bigint 的十进制串比对
import {
  "moonbitlang/core/double",
  "moonbitlang/core/json",
  "mldong/moon-hutool/conv",
} for "test"
