///|
// typex 第四批第二格（CoordinateUtil）的期望值全部由生成脚本从参照腿灌入（手打零条）。
// 腿：Temp/convsrc/coord/CoordinateLeg.java，116 行读数、零 ERR；十进制串两边都可往返到同一个 double。
// 不进契约的字段：CONST（四枚常量随实现做包内常量）、CONST_CHK（PI==Math.PI 只作分岔证据）、
// EQ_CHK（参照 Coordinate bean 的 Double.compare 相等语义——本库摊平成二元组，bean 不移植，见 spec §17.5）。

///|

///|
test "outOfChina：只看四个边界常量，边界值本身算「国内”" {
  assert_eq(@typex.coord_out_of_china(116.397428, 39.90923), false) // OUT_OF_CHINA|116.397428,39.90923
  assert_eq(@typex.coord_out_of_china(121.473701, 31.230416), false) // OUT_OF_CHINA|121.473701,31.230416
  assert_eq(@typex.coord_out_of_china(113.264385, 23.129112), false) // OUT_OF_CHINA|113.264385,23.129112
  assert_eq(@typex.coord_out_of_china(-73.985428, 40.748817), true) // OUT_OF_CHINA|-73.985428,40.748817
  assert_eq(@typex.coord_out_of_china(0.0, 0.0), true) // OUT_OF_CHINA|0.0,0.0
  assert_eq(@typex.coord_out_of_china(72.003, 0.8292), true) // OUT_OF_CHINA|72.003,0.8292
  assert_eq(@typex.coord_out_of_china(72.004, 0.8293), false) // OUT_OF_CHINA|72.004,0.8293
  assert_eq(@typex.coord_out_of_china(137.8347, 55.8271), false) // OUT_OF_CHINA|137.8347,55.8271
  assert_eq(@typex.coord_out_of_china(137.8348, 55.8272), true) // OUT_OF_CHINA|137.8348,55.8272
  assert_eq(@typex.coord_out_of_china(-0.0, -0.0), true) // OUT_OF_CHINA|-0.0,-0.0
  assert_eq(@typex.coord_out_of_china(105.0, 35.0), false) // OUT_OF_CHINA|105.0,35.0
  assert_eq(@typex.coord_out_of_china(100000000.0, -100000000.0), true) // OUT_OF_CHINA|1.0E8,-1.0E8
}

///|
test "wgs84 与 gcj02 互转，以及两条经过 gcj02 的复合路（参照不查 outOfChina，国外照样偏移）" {
  assert_eq(
    @typex.coord_wgs84_to_gcj02(116.397428, 39.90923),
    (116.40367162595768, 39.91063350638631),
  ) // WGS84_GCJ02|116.397428,39.90923
