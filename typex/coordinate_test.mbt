    (-73.94686302816342, 40.7459476153335),
  ) // WGS84_GCJ02|-73.985428,40.748817
  assert_eq(
    @typex.coord_wgs84_to_gcj02(0.0, 0.0),
    (0.015498497079753525, 0.002728458322254793),
  ) // WGS84_GCJ02|0.0,0.0
  assert_eq(
    @typex.coord_wgs84_to_gcj02(72.003, 0.8292),
    (72.00670715190266, 0.8304597849643879),
  ) // WGS84_GCJ02|72.003,0.8292
  assert_eq(
