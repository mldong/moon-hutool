///|
test "gcj02 与 bd09 互转" {
  assert_eq(
    @typex.coord_gcj02_to_bd09(116.397428, 39.90923),
    (116.40380056450005, 39.9155730161122),
  ) // GCJ02_BD09|116.397428,39.90923
  assert_eq(
    @typex.coord_gcj02_to_bd09(121.473701, 31.230416),
    (121.48023840790201, 31.236350800982365),
  ) // GCJ02_BD09|121.473701,31.230416
  assert_eq(
    @typex.coord_gcj02_to_bd09(113.264385, 23.129112),
    (113.27081796617938, 23.135340412528762),
  ) // GCJ02_BD09|113.264385,23.129112
  assert_eq(
    @typex.coord_gcj02_to_bd09(-73.985428, 40.748817),
    (-73.97880285397353, 40.75502575416779),
  ) // GCJ02_BD09|-73.985428,40.748817
  assert_eq(@typex.coord_gcj02_to_bd09(0.0, 0.0), (0.0065, 0.006)) // GCJ02_BD09|0.0,0.0
  assert_eq(
    @typex.coord_gcj02_to_bd09(72.003, 0.8292),
    (72.00948682688542, 0.8354132261299249),
  ) // GCJ02_BD09|72.003,0.8292
  assert_eq(
    @typex.coord_gcj02_to_bd09(72.004, 0.8293),
    (72.01048693889018, 0.8355111691861248),
  ) // GCJ02_BD09|72.004,0.8293
  assert_eq(
    @typex.coord_gcj02_to_bd09(137.8347, 55.8271),
    (137.84133859634227, 55.83281047338818),
  ) // GCJ02_BD09|137.8347,55.8271
  assert_eq(
    @typex.coord_gcj02_to_bd09(137.8348, 55.8272),
    (137.84143799907454, 55.83291198981285),
  ) // GCJ02_BD09|137.8348,55.8272
  assert_eq(@typex.coord_gcj02_to_bd09(-0.0, -0.0), (0.0065, 0.006)) // GCJ02_BD09|-0.0,-0.0
  assert_eq(
    @typex.coord_gcj02_to_bd09(105.0, 35.0),
    (105.0063785678672, 35.00630952256762),
  ) // GCJ02_BD09|105.0,35.0
  assert_eq(
    @typex.coord_gcj02_to_bd09(100000000.0, -100000000.0),
    (99999850.00647224, -100000149.99377829),
  ) // GCJ02_BD09|1.0E8,-1.0E8

  assert_eq(
    @typex.coord_bd09_to_gcj02(116.397428, 39.90923),
    (116.39103764046327, 39.90292057617438),
  ) // BD09_GCJ02|116.397428,39.90923
  assert_eq(
    @typex.coord_bd09_to_gcj02(121.473701, 31.230416),
    (121.46719613101034, 31.22435801798287),
  ) // BD09_GCJ02|121.473701,31.230416
  assert_eq(
    @typex.coord_bd09_to_gcj02(113.264385, 23.129112),
    (113.25793116796865, 23.122979416443872),
  ) // BD09_GCJ02|113.264385,23.129112
  assert_eq(
    @typex.coord_bd09_to_gcj02(-73.985428, 40.748817),
    (-73.99202972956199, 40.74263834484508),
  ) // BD09_GCJ02|-73.985428,40.748817
  assert_eq(
    @typex.coord_bd09_to_gcj02(0.0, 0.0),
    (-0.006504558314413798, -0.006004173607198179),
  ) // BD09_GCJ02|0.0,0.0
  assert_eq(
    @typex.coord_bd09_to_gcj02(72.003, 0.8292),
    (71.99651783719123, 0.8229878034028515),
  ) // BD09_GCJ02|72.003,0.8292
  assert_eq(
    @typex.coord_bd09_to_gcj02(72.004, 0.8293),
    (71.9975177907517, 0.8230860307375355),
  ) // BD09_GCJ02|72.004,0.8293
  assert_eq(
    @typex.coord_bd09_to_gcj02(137.8347, 55.8271),
    (137.8280311750711, 55.8214692476886),
  ) // BD09_GCJ02|137.8347,55.8271
  assert_eq(
    @typex.coord_bd09_to_gcj02(137.8348, 55.8272),
    (137.82813149851506, 55.821568323987236),
  ) // BD09_GCJ02|137.8348,55.8272
  assert_eq(
    @typex.coord_bd09_to_gcj02(-0.0, -0.0),
    (-0.006504558314413798, -0.006004173607198179),
  ) // BD09_GCJ02|-0.0,-0.0
  assert_eq(
    @typex.coord_bd09_to_gcj02(105.0, 35.0),
    (104.99361165598081, 34.99370731767234),
  ) // BD09_GCJ02|105.0,35.0
  assert_eq(
    @typex.coord_bd09_to_gcj02(100000000.0, -100000000.0),
    (100000054.66390741, -99999945.33558162),
  ) // BD09_GCJ02|1.0E8,-1.0E8
}

///|
test "墨卡托投影两档（这一对用 Math.PI，其余用类内 PI 字面量）" {
  assert_eq(
    @typex.coord_wgs84_to_mercator(116.397428, 39.90923),
    (12957302.414606724, 4852760.584444312),
  ) // WGS84_MERCATOR|116.397428,39.90923
  assert_eq(
    @typex.coord_wgs84_to_mercator(121.473701, 31.230416),
    (13522390.540094368, 3662709.340004821),
  ) // WGS84_MERCATOR|121.473701,31.230416
  assert_eq(
    @typex.coord_wgs84_to_mercator(113.264385, 23.129112),
    (12608533.663213296, 2647640.035468934),
  ) // WGS84_MERCATOR|113.264385,23.129112
  assert_eq(
    @typex.coord_wgs84_to_mercator(-73.985428, 40.748817),
    (-8236020.171082405, 4975362.528079464),
  ) // WGS84_MERCATOR|-73.985428,40.748817
  assert_eq(
    @typex.coord_wgs84_to_mercator(0.0, 0.0),
    (0.0, -7.081154551613622e-10),
  ) // WGS84_MERCATOR|0.0,0.0
  assert_eq(
    @typex.coord_wgs84_to_mercator(72.003, 0.8292),
    (8015337.295588077, 92309.34413512635),
  ) // WGS84_MERCATOR|72.003,0.8292
  assert_eq(
    @typex.coord_wgs84_to_mercator(72.004, 0.8293),
    (8015448.615078872, 92320.47725022398),
  ) // WGS84_MERCATOR|72.004,0.8293
  assert_eq(
    @typex.coord_wgs84_to_mercator(137.8347, 55.8271),
    (15343688.617643626, 7524072.870045348),
  ) // WGS84_MERCATOR|137.8347,55.8271
  assert_eq(
    @typex.coord_wgs84_to_mercator(137.8348, 55.8272),
    (15343699.749592705, 7524092.688666643),
  ) // WGS84_MERCATOR|137.8348,55.8272
  assert_eq(
    @typex.coord_wgs84_to_mercator(-0.0, -0.0),
    (-0.0, -7.081154551613622e-10),
  ) // WGS84_MERCATOR|-0.0,-0.0
  assert_eq(
    @typex.coord_wgs84_to_mercator(105.0, 35.0),
    (11688546.533293726, 4163881.1440642904),
  ) // WGS84_MERCATOR|105.0,35.0
  assert_eq(
    @typex.coord_wgs84_to_mercator(100000000.0, -100000000.0),
    (11131949079327.357, 15538711.105282959),
  ) // WGS84_MERCATOR|1.0E8,-1.0E8

  assert_eq(
    @typex.coord_mercator_to_wgs84(116.397428, 39.90923),
    (0.0010456158860460154, 0.000358510712864122),
  ) // MERCATOR_WGS84|116.397428,39.90923
  assert_eq(
    @typex.coord_mercator_to_wgs84(121.473701, 31.230416),
    (0.001091216822268648, 0.0002805476002217944),
  ) // MERCATOR_WGS84|121.473701,31.230416
  assert_eq(
    @typex.coord_mercator_to_wgs84(113.264385, 23.129112),
    (0.0010174712819189787, 0.00020777234818105262),
  ) // MERCATOR_WGS84|113.264385,23.129112
  assert_eq(
    @typex.coord_mercator_to_wgs84(-73.985428, 40.748817),
    (-0.000664622407745244, 0.0003660528512103631),
  ) // MERCATOR_WGS84|-73.985428,40.748817
  assert_eq(@typex.coord_mercator_to_wgs84(0.0, 0.0), (0.0, 0.0)) // MERCATOR_WGS84|0.0,0.0
  assert_eq(
    @typex.coord_mercator_to_wgs84(72.003, 0.8292),
    (0.0006468139540245789, 7.448830337217673e-06),
  ) // MERCATOR_WGS84|72.003,0.8292
  assert_eq(
    @typex.coord_mercator_to_wgs84(72.004, 0.8293),
    (0.0006468229371774202, 7.449728653081906e-06),
  ) // MERCATOR_WGS84|72.004,0.8293
  assert_eq(
    @typex.coord_mercator_to_wgs84(137.8347, 55.8271),
    (0.00123819017692029, 0.000501503371971451),
  ) // MERCATOR_WGS84|137.8347,55.8271
  assert_eq(
    @typex.coord_mercator_to_wgs84(137.8348, 55.8272),
    (0.001238191075235574, 0.0005015042703000374),
  ) // MERCATOR_WGS84|137.8348,55.8272
  assert_eq(@typex.coord_mercator_to_wgs84(-0.0, -0.0), (-0.0, 0.0)) // MERCATOR_WGS84|-0.0,-0.0
  assert_eq(
    @typex.coord_mercator_to_wgs84(105.0, 35.0),
    (0.0009432310483254975, 0.0003144103494347836),
  ) // MERCATOR_WGS84|105.0,35.0
  assert_eq(
    @typex.coord_mercator_to_wgs84(100000000.0, -100000000.0),
    (898.3152841195214, -89.99998221553587),
  ) // MERCATOR_WGS84|1.0E8,-1.0E8
}
